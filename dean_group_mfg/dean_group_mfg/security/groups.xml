<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dg_user" model="res.groups">
        <field name="name">Dean Group / User</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
    </record>
    <record id="group_dg_manager" model="res.groups">
        <field name="name">Dean Group / Manager</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('group_dg_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
