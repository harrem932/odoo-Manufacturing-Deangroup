<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════
     STOCK LOCATIONS — Foundry warehouse structure
══════════════════════════════════════════ -->

<!-- UK Foundry Warehouse -->
<record id="stock_warehouse_manchester" model="stock.warehouse">
    <field name="name">Manchester Foundry</field>
    <field name="code">MCR</field>
    <field name="is_foundry_warehouse" eval="True"/>
    <field name="site">manchester</field>
    <field name="company_id" ref="company_dg_uk"/>
</record>

<!-- Raw Material Store -->
<record id="loc_raw_material" model="stock.location">
    <field name="name">Raw Material Store</field>
    <field name="usage">internal</field>
    <field name="location_id" ref="stock.stock_location_locations"/>
    <field name="is_foundry_location" eval="True"/>
    <field name="foundry_zone">raw_material</field>
    <field name="site">manchester</field>
</record>

<!-- Wax Room -->
<record id="loc_wax_room" model="stock.location">
    <field name="name">Wax Room – WIP</field>
