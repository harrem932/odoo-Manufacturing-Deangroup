<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════
     SHARED WEBSITE TEMPLATES
     Override Odoo's default website header/footer
     to match Dean Group branding
══════════════════════════════════════════ -->

<!-- Custom footer for Dean Group website -->
<template id="dg_footer" name="Dean Group Footer" inherit_id="website.footer_custom">
    <xpath expr="//div[hasclass('o_footer_copyright')]" position="replace">
        <div class="o_footer_copyright" style="background:#060b12;border-top:1px solid rgba(255,255,255,0.07);padding:1.5rem 0">
            <div class="container">
                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem">
                    <p style="font-size:.75rem;color:#7a8fa6;margin:0">
                        © <span t-field="res_company.name"/>
                        · VAT No: GB146307478
                        · Company No: 1062820
                        · Powered by
                        <a href="https://www.zenvora.com" style="color:#d94f0c;text-decoration:none">Zenvora</a>
                        /
                        <a href="https://www.odoo.com" style="color:#7a8fa6;text-decoration:none">Odoo 17</a>
                    </p>
                    <div style="display:flex;gap:1.5rem">
                        <a href="/terms-and-conditions" style="font-size:.75rem;color:#7a8fa6;text-decoration:none">Terms &amp; Conditions</a>
                        <a href="/privacy-policy" style="font-size:.75rem;color:#7a8fa6;text-decoration:none">Privacy Policy</a>
                        <a href="/sitemap.xml" style="font-size:.75rem;color:#7a8fa6;text-decoration:none">Sitemap</a>
                    </div>
                </div>
            </div>
        </div>
    </xpath>
</template>

<!-- Inject Dean Group CSS into every website page -->
<template id="dg_assets_frontend" inherit_id="website.assets_frontend" name="Dean Group Frontend Assets">
    <xpath expr="." position="inside">
        <link rel="stylesheet" href="/dean_group_mfg/static/src/css/website.css"/>
    </xpath>
</template>

<!-- ══════════════════════════════════════════
     404 PAGE
══════════════════════════════════════════ -->
<template id="404" name="Dean Group 404">
    <t t-call="website.layout">
        <section class="dg-section" style="padding-top:7rem;text-align:center;min-height:70vh;display:flex;align-items:center">
            <div class="container">
                <div style="font-size:5rem;margin-bottom:1rem">🔩</div>
                <h1 class="dg-heading" style="font-size:4rem">404</h1>
                <h2 style="color:#fff;margin-bottom:1rem;font-size:1.4rem">Page Not Found</h2>
                <p style="color:var(--dg-steel);max-width:400px;margin:0 auto 2rem">
                    This page doesn't exist or has been moved. Head back to our homepage to find what you need.
                </p>
                <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
                    <a href="/" class="dg-btn dg-btn-fire">Back to Homepage</a>
                    <a href="/contact" class="dg-btn dg-btn-ghost">Contact Us</a>
                </div>
            </div>
        </section>
    </t>
</template>

<!-- ══════════════════════════════════════════
     TERMS &amp; CONDITIONS PAGE
══════════════════════════════════════════ -->
<template id="terms_page" name="Dean Group – Terms &amp; Conditions">
    <t t-call="website.layout">
        <section class="dg-section" style="padding-top:7rem">
            <div class="container" style="max-width:800px">
                <div class="dg-label">Legal</div>
                <h1 class="dg-heading">Terms &amp; Conditions</h1>
                <div style="color:var(--dg-mist);line-height:1.8;font-size:.9rem;margin-top:2rem">
                    <p style="margin-bottom:1rem">These terms and conditions govern the supply of goods by Dean Group International Ltd (Company No. 1062820, VAT No. GB146307478), registered in England.</p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">1. Orders and Quotations</h3>
                    <p style="margin-bottom:1rem">All quotations are valid for 30 days from date of issue. Orders are accepted subject to these terms. No order shall be binding on Dean Group until confirmed in writing.</p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">2. Delivery</h3>
                    <p style="margin-bottom:1rem">Lead times given are estimates. Dean Group shall not be liable for delays caused by circumstances beyond its reasonable control. Risk passes to the buyer on delivery.</p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">3. Payment</h3>
                    <p style="margin-bottom:1rem">Unless otherwise agreed, payment terms are 30 days net from date of invoice. Dean Group reserves the right to charge interest on overdue accounts.</p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">4. Quality and Returns</h3>
                    <p style="margin-bottom:1rem">All goods are supplied with a Certificate of Conformity. Claims for defects must be made within 14 days of delivery. Unauthorised returns will not be accepted.</p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">5. Intellectual Property</h3>
                    <p style="margin-bottom:1rem">All designs, drawings and tooling produced by Dean Group remain the property of Dean Group unless otherwise agreed in writing.</p>
                    <p style="margin-top:2rem;color:var(--dg-steel);font-size:.82rem">
                        Last updated: April 2026 · For the full legal terms please contact
                        <a href="mailto:sales@deangroup-int.co.uk" style="color:var(--dg-ember)">sales@deangroup-int.co.uk</a>
                    </p>
                </div>
            </div>
        </section>
    </t>
</template>

<!-- ══════════════════════════════════════════
     PRIVACY POLICY PAGE
══════════════════════════════════════════ -->
<template id="privacy_page" name="Dean Group – Privacy Policy">
    <t t-call="website.layout">
        <section class="dg-section" style="padding-top:7rem">
            <div class="container" style="max-width:800px">
                <div class="dg-label">Legal</div>
                <h1 class="dg-heading">Privacy Policy</h1>
                <div style="color:var(--dg-mist);line-height:1.8;font-size:.9rem;margin-top:2rem">
                    <p style="margin-bottom:1rem">Dean Group International Ltd is committed to protecting your personal data in accordance with the UK General Data Protection Regulation (UK GDPR) and the Data Protection Act 2018.</p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">Data We Collect</h3>
                    <p style="margin-bottom:1rem">We collect contact information, company details and enquiry information submitted through this website, by email or by telephone. We also collect technical data (IP address, browser type) via cookies.</p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">How We Use Your Data</h3>
                    <p style="margin-bottom:1rem">Your data is used to respond to enquiries, process orders, manage our customer relationship and comply with legal obligations. We do not sell your data to third parties.</p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">Data Retention</h3>
                    <p style="margin-bottom:1rem">Customer and supplier records are retained for 7 years in accordance with HMRC requirements. Enquiry data is retained for 3 years.</p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">Your Rights</h3>
                    <p style="margin-bottom:1rem">You have the right to access, correct or delete your personal data. To exercise these rights, contact us at
                        <a href="mailto:sales@deangroup-int.co.uk" style="color:var(--dg-ember)">sales@deangroup-int.co.uk</a>
                    </p>
                    <h3 style="color:#fff;margin:1.5rem 0 .5rem">Cookies</h3>
                    <p style="margin-bottom:1rem">We use essential cookies to operate this website and optional analytics cookies to improve our service. You can control cookie preferences via the banner shown on first visit.</p>
                    <p style="margin-top:2rem;color:var(--dg-steel);font-size:.82rem">
                        Data Controller: Dean Group International Ltd · ICO Registration No: [on file]
                        · Last updated: April 2026
                    </p>
                </div>
            </div>
        </section>
    </t>
</template>

<!-- ══════════════════════════════════════════
     QUALITY PAGE
══════════════════════════════════════════ -->
<template id="quality_page" name="Dean Group – Quality">
    <t t-call="website.layout">
        <section class="dg-section" style="padding-top:7rem">
            <div class="container">
                <div class="dg-label">Quality Assurance</div>
                <h1 class="dg-heading">Quality is Our Cornerstone</h1>
                <p class="dg-sub">Every casting leaves Dean Group with full visual, dimensional and chemical inspection. Our ISO 9001:2015 and BSI accreditations ensure the highest international quality standards.</p>

                <!-- Accreditations -->
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin:2.5rem 0">
                    <div style="background:var(--dg-card);border:1px solid var(--dg-border);border-radius:6px;padding:1.8rem;text-align:center">
                        <div style="font-size:2.5rem;margin-bottom:.8rem">🏅</div>
                        <div style="font-size:1rem;font-weight:700;color:#fff;margin-bottom:.4rem">ISO 9001:2015</div>
                        <div style="font-size:.82rem;color:var(--dg-steel)">International quality management system. Certified by BSI.</div>
                    </div>
                    <div style="background:var(--dg-card);border:1px solid var(--dg-border);border-radius:6px;padding:1.8rem;text-align:center">
                        <div style="font-size:2.5rem;margin-bottom:.8rem">🇬🇧</div>
                        <div style="font-size:1rem;font-weight:700;color:#fff;margin-bottom:.4rem">BSI Certified</div>
                        <div style="font-size:.82rem;color:var(--dg-steel)">British Standards Institution certification. BSI Cert No. FS 25398.</div>
                    </div>
                    <div style="background:var(--dg-card);border:1px solid var(--dg-border);border-radius:6px;padding:1.8rem;text-align:center">
                        <div style="font-size:2.5rem;margin-bottom:.8rem">⚗️</div>
                        <div style="font-size:1rem;font-weight:700;color:#fff;margin-bottom:.4rem">Cast Metals Federation</div>
                        <div style="font-size:.82rem;color:var(--dg-steel)">Full member. Advocates for UK casting industry standards.</div>
                    </div>
                </div>

                <!-- QA steps -->
                <h2 class="dg-heading" style="font-size:1.8rem;margin-bottom:1.5rem">Our Quality Process</h2>
                <div class="dg-steps" style="margin-bottom:2.5rem">
                    <div class="dg-step">
                        <div class="dg-step-num">01</div>
                        <div class="dg-step-title">Incoming Inspection</div>
                        <p class="dg-step-desc">All raw materials and China supply batches inspected on arrival. Chemical and dimensional checks before use.</p>
                    </div>
                    <div class="dg-step">
                        <div class="dg-step-num">02</div>
                        <div class="dg-step-title">In-Process Checks</div>
                        <p class="dg-step-desc">Process parameters monitored throughout casting. Shell thickness, wax weight and visual checks at each stage.</p>
                    </div>
                    <div class="dg-step">
                        <div class="dg-step-num">03</div>
                        <div class="dg-step-title">Final Inspection</div>
                        <p class="dg-step-desc">100% dimensional, visual and chemical inspection before release. CMM for critical dimensions.</p>
                    </div>
                    <div class="dg-step">
                        <div class="dg-step-num">04</div>
                        <div class="dg-step-title">NDT Where Required</div>
                        <p class="dg-step-desc">X-ray, ultrasonic, dye penetrant and magnetic particle testing available for aerospace and defence parts.</p>
                    </div>
                    <div class="dg-step">
                        <div class="dg-step-num">05</div>
                        <div class="dg-step-title">Certificate Issued</div>
                        <p class="dg-step-desc">Certificate of Conformity issued with every delivery. Available in EN, ZH, DE, FR and AR languages.</p>
                    </div>
                </div>

                <!-- Quick links -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;max-width:600px">
                    <a href="/get-quote" class="dg-btn dg-btn-fire">Request a Quote</a>
                    <a href="/contact" class="dg-btn dg-btn-ghost">Contact Quality Team</a>
                </div>
            </div>
        </section>
    </t>
</template>

<!-- ══════════════════════════════════════════
     ABOUT PAGE
══════════════════════════════════════════ -->
<template id="about_page" name="Dean Group – About Us">
    <t t-call="website.layout">
        <section class="dg-section" style="padding-top:7rem">
            <div class="container">
                <div class="dg-label">Our Story</div>
                <h1 class="dg-heading">About Dean Group International</h1>
                <p class="dg-sub">Family-owned foundry with over 50 years of heritage. Two sites in Manchester, supported by quality-assured Asia supply partnerships.</p>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;margin-top:3rem;align-items:start">
                    <div>
                        <h2 style="color:#fff;font-size:1.4rem;margin-bottom:1rem">Who We Are</h2>
                        <p style="color:var(--dg-steel);line-height:1.8;margin-bottom:1rem;font-size:.92rem">
                            Dean Group International Ltd is a family-owned precision casting foundry based in Irlam, Manchester. Founded in 1972 as Manchester Investment Castings, we rebranded to Dean Group International in 2007 following significant expansion of our process capability.
                        </p>
                        <p style="color:var(--dg-steel);line-height:1.8;margin-bottom:1rem;font-size:.92rem">
                            Today we manufacture and supply critical metal components via investment casting, die casting, MIM, forging and powder pressing. We serve demanding markets including aerospace, defence, oil and gas, medical and rail.
                        </p>
                        <p style="color:var(--dg-steel);line-height:1.8;font-size:.92rem">
                            Our UK foundry in Manchester is complemented by quality-assured Asia supply partnerships for high-volume, cost-competitive production. All Asia partners are ISO 9001 certified and every shipment is UK-inspected before dispatch.
                        </p>
                    </div>
                    <div>
                        <h2 style="color:#fff;font-size:1.4rem;margin-bottom:1rem" id="timeline">Key Milestones</h2>
                        <div style="position:relative;padding-left:1.5rem">
                            <div style="position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(to bottom,var(--dg-fire),transparent)"></div>
                            <t t-foreach="[('1972','Founded as Manchester Investment Castings'),('1990s','Shell development for non-ferrous metals. Spectrometer capability added'),('2000','Re-aligned to market – introduced China supply chain'),('2007','Rebranded to Dean Group International. ELITE aluminium process launched'),('2010s','New warehouse, material testing lab. Four apprentices started. 300% UK throughput increase'),('2024','Continued investment in 3D printing, CMM and metrology capability')]" t-as="milestone">
                                <div style="margin-bottom:1.2rem;padding-bottom:1.2rem;border-bottom:1px solid rgba(255,255,255,.06)">
                                    <div style="color:var(--dg-fire);font-weight:700;font-size:.85rem;margin-bottom:.2rem"><t t-esc="milestone[0]"/></div>
                                    <div style="color:var(--dg-mist);font-size:.83rem"><t t-esc="milestone[1]"/></div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <div style="margin-top:3rem;text-align:center">
                    <a href="/get-quote" class="dg-btn dg-btn-fire">Start a Project with Us</a>
                    <a href="/contact" class="dg-btn dg-btn-ghost" style="margin-left:1rem">Get in Touch</a>
                </div>
            </div>
        </section>
    </t>
</template>

</odoo>
