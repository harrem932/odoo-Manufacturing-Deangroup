<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════
     CASTING PROCESS VIEWS
══════════════════════════════════════════ -->
<record id="view_casting_process_list" model="ir.ui.view">
    <field name="name">dg.casting.process.list</field>
    <field name="model">dg.casting.process</field>
    <field name="arch" type="xml">
        <list string="Casting Processes" decoration-info="supply_location=='uk'" decoration-warning="supply_location=='china'">
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="code"/>
            <field name="supply_location"/>
            <field name="lead_time_uk"/>
            <field name="lead_time_china"/>
            <field name="min_quantity"/>
            <field name="active" widget="boolean_toggle"/>
        </list>
    </field>
</record>

<record id="view_casting_process_form" model="ir.ui.view">
    <field name="name">dg.casting.process.form</field>
    <field name="model">dg.casting.process</field>
    <field name="arch" type="xml">
        <form string="Casting Process">
            <sheet>
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="supply_location" widget="radio"/>
                        <field name="website_url"/>
                    </group>
                    <group>
                        <field name="lead_time_uk"/>
                        <field name="lead_time_china"/>
                        <field name="min_quantity"/>
                        <field name="max_tolerance"/>
                        <field name="active"/>
                    </group>
                </group>
                <field name="description" placeholder="Process description shown on website..."/>
            </sheet>
        </form>
    </field>
</record>

<!-- ══════════════════════════════════════════
     CASTING ENQUIRY VIEWS
══════════════════════════════════════════ -->
<record id="view_casting_enquiry_kanban" model="ir.ui.view">
    <field name="name">dg.casting.enquiry.kanban</field>
    <field name="model">dg.casting.enquiry</field>
    <field name="arch" type="xml">
        <kanban default_group_by="state" class="o_kanban_small_column"
                decoration-danger="state=='lost'" decoration-success="state=='approved'">
            <field name="name"/>
            <field name="partner_id"/>
            <field name="process_id"/>
            <field name="industry"/>
            <field name="estimated_value"/>
            <field name="state"/>
            <field name="priority"/>
            <field name="user_id"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <small class="o_kanban_record_subtitle text-muted">
                                    <field name="partner_id"/>
                                </small>
                            </div>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="process_id" widget="badge"/>
                            <t t-if="record.industry.value">
                                <span class="badge rounded-pill bg-info">
                                    <t t-esc="record.industry.value"/>
                                </span>
                            </t>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left text-muted">
                                <t t-if="record.estimated_value.raw_value">
                                    £<t t-esc="record.estimated_value.value"/>
                                </t>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

<record id="view_casting_enquiry_list" model="ir.ui.view">
    <field name="name">dg.casting.enquiry.list</field>
    <field name="model">dg.casting.enquiry</field>
    <field name="arch" type="xml">
        <list string="Casting Enquiries" decoration-danger="state=='lost'"
              decoration-success="state=='approved'" decoration-warning="state=='quoted'">
            <field name="name"/>
            <field name="partner_id"/>
            <field name="process_id"/>
            <field name="industry"/>
            <field name="supply_route"/>
            <field name="quantity_annual"/>
            <field name="estimated_value" widget="monetary"/>
            <field name="state" widget="badge"
                   decoration-success="state=='approved'"
                   decoration-warning="state in ['quoted','sampling']"
                   decoration-danger="state=='lost'"/>
            <field name="priority" widget="priority"/>
            <field name="user_id" widget="many2one_avatar_user"/>
        </list>
    </field>
</record>

<record id="view_casting_enquiry_form" model="ir.ui.view">
    <field name="name">dg.casting.enquiry.form</field>
    <field name="model">dg.casting.enquiry</field>
    <field name="arch" type="xml">
        <form string="Casting Enquiry">
            <header>
                <button name="action_set_review"  string="Under Review"   type="object" invisible="state != 'new'"/>
                <button name="action_set_quoted"  string="Mark Quoted"    type="object" invisible="state not in ['new','review']" class="btn-primary"/>
                <button name="action_set_approved" string="Approve"       type="object" invisible="state not in ['quoted','sampling']" class="btn-success"/>
                <button name="action_set_lost"    string="Mark Lost"      type="object" invisible="state in ['lost','cancelled']"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="new,review,quoted,sampling,approved"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object" name="action_set_approved"
                            icon="fa-check-circle" invisible="state != 'quoted'">
                        <div class="o_stat_info"><span class="o_stat_text">Approve</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <label for="name"/>
                    <h1><field name="name" readonly="1"/></h1>
                </div>
                <group>
                    <group string="Customer">
                        <field name="partner_id"/>
                        <field name="contact_name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="industry"/>
                    </group>
                    <group string="Casting Details">
                        <field name="process_id"/>
                        <field name="material"/>
                        <field name="quantity_annual"/>
                        <field name="weight_grams"/>
                        <field name="drawing_ref"/>
                        <field name="has_cad"/>
                        <field name="supply_route"/>
                        <field name="estimated_value" widget="monetary"/>
                    </group>
                </group>
                <group>
                    <group string="Assignment">
                        <field name="user_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="priority" widget="priority"/>
                    </group>
                    <group string="Linked Records">
                        <field name="sale_order_id"/>
                        <field name="crm_lead_id"/>
                    </group>
                </group>
                <field name="description" placeholder="Component description, application, special requirements..."/>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </sheet>
        </form>
    </field>
</record>

<record id="action_casting_enquiry" model="ir.actions.act_window">
    <field name="name">Casting Enquiries</field>
    <field name="res_model">dg.casting.enquiry</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">{'search_default_my_enquiries': 1}</field>
</record>

<record id="action_casting_process" model="ir.actions.act_window">
    <field name="name">Casting Processes</field>
    <field name="res_model">dg.casting.process</field>
    <field name="view_mode">list,form</field>
</record>

</odoo>
